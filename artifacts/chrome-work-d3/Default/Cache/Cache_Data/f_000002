    const beExitOpacity = reducedMotion.matches ? performanceExit : 1 - smoothstep(0.77, 0.875, orbitProgress);
    const tailExit = reducedMotion.matches ? performanceExit : 1 - smoothstep(0.8, 0.91, orbitProgress);
    const oExit = reducedMotion.matches ? performanceExit : 1 - smoothstep(0.845, 0.915, orbitProgress);
    const logoMorph = reducedMotion.matches
