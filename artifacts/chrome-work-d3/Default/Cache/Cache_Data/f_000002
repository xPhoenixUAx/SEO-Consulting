  }

  function drawFragments(seconds, scroll) {
    ambientContext.save();
    ambientContext.textBaseline = "middle";
    const centerX = width * 0.7;
    const centerY = height * 0.52;
    for (let index = 0; index < fragments.length; index += 1) {
      const fragment = fragments[index];
      const appeared = smoothstep(fragment.delay, fragment.delay + 1.5, seconds);
      if (appeared <= 0.002) continue;
      const depthFade = 1 - smoothstep(0.08, 0.96, scroll);
      const dx = fragment.x - centerX;
      const dy = fragment.y - centerY;
      const turn = fragment.orbit * (0.025 + seconds * 0.0065 * fragment.speed);
      const cosine = Math.cos(turn);
      const sine = Math.sin(turn);
      const x = centerX + dx * cosine - dy * sine + Math.cos(seconds * fragment.speed * 0.72 + fragment.phase) * 10 + scroll * fragment.speed * 54;
      const y = centerY + dx * sine + dy * cosine + Math.sin(seconds * fragment.speed + fragment.phase) * 7 - scroll * height * (0.34 + fragment.speed * 0.2);
      const pointerDistance = Math.hypot(pointer.x - x, pointer.y - y);
      const field = smoothstep(175, 0, pointerDistance);
      const alpha = fragment.alpha * appeared * depthFade * (0.82 + field * 0.42) * (0.65 + fragment.depth * 0.55);
      if (alpha <= 0.002) continue;

      ambientContext.font = `${fragment.size}px "IBM Plex Mono", monospace`;
      ambientContext.fillStyle = fragment.accent && (field > 0.08 || index % 7 === 0)
        ? `rgba(216,255,0,${Math.min(0.72, alpha * 1.32)})`
        : `rgba(240,237,228,${alpha})`;
      ambientContext.fillText(fragment.label, x, y);
    }
    ambientContext.restore();
  }

  function cubic(from, controlA, controlB, to, amount) {
    const inverse = 1 - amount;
    return inverse * inverse * inverse * from
      + 3 * inverse * inverse * amount * controlA
      + 3 * inverse * amount * amount * controlB
      + amount * amount * amount * to;
  }

  function cubicDerivative(from, controlA, controlB, to, amount) {
    const inverse = 1 - amount;
    return 3 * inverse * inverse * (controlA - from)
      + 6 * inverse * amount * (controlB - controlA)
      + 3 * amount * amount * (to - controlB);
  }

  function buildStaticField() {
    const random = mulberry32(19082026 + Math.round(width));
    const staticContext = staticFieldCanvas.getContext("2d");
    staticFieldCanvas.width = Math.max(1, Math.round(width));
    staticFieldCanvas.height = Math.max(1, Math.round(height));
    staticContext.clearRect(0, 0, width, height);
    staticContext.globalCompositeOperation = "lighter";
    staticContext.lineCap = "round";

    const isMobile = width < 700;
    const count = isMobile ? 1580 : 4250;
    const centerX = width * (isMobile ? 0.72 : 0.69);
    const centerY = height * (isMobile ? 0.43 : 0.51);
    const ignitionX = width * (isMobile ? 0.77 : 0.79);
    const ignitionY = height * (isMobile ? 0.5 : 0.72);

    for (let index = 0; index < count; index += 1) {
      const familyRoll = random();
      const family = familyRoll < 0.56 ? 0 : familyRoll < 0.84 ? 1 : 2;
      const progress = random();
      const lane = random() * 2 - 1;
      let x;
      let y;
      let alphaFade = 1;
      let accent = random() > 0.94;

      if (family === 0) {
        const p0x = -width * 0.18;
        const p0y = height * 0.64;
        const p1x = width * 0.31;
        const p1y = height * 0.96;
        const p2x = width * 0.53;
        const p2y = height * 0.06;
        const p3x = width * 1.16;
        const p3y = height * 0.57;
        x = cubic(p0x, p1x, p2x, p3x, progress);
        y = cubic(p0y, p1y, p2y, p3y, progress);
        const tangentX = cubicDerivative(p0x, p1x, p2x, p3x, progress);
        const tangentY = cubicDerivative(p0y, p1y, p2y, p3y, progress);
        const tangentLength = Math.hypot(tangentX, tangentY) || 1;
        const spread = (isMobile ? 45 : 116) * (0.25 + Math.sin(Math.PI * progress) * 0.75);
        x += (-tangentY / tangentLength) * lane * spread;
        y += (tangentX / tangentLength) * lane * spread;
        alphaFade = Math.pow(Math.sin(Math.PI * progress), 0.3);
      } else if (family === 1) {
        const angle = progress * Math.PI * 5.4 + lane * 0.68 + (random() - 0.5) * 0.14;
        const radius = mix(width * 0.44, width * 0.028, progress);
        x = centerX + Math.cos(angle) * radius;
        y = centerY + Math.sin(angle) * radius * (isMobile ? 0.59 : 0.52);
        alphaFade = Math.pow(Math.sin(Math.PI * progress), 0.26);
      } else {
        const angle = random() * Math.PI * 2;
        const radius = Math.pow(random(), 0.58) * width * (isMobile ? 0.2 : 0.16);
        x = ignitionX + Math.cos(angle) * radius;
        y = ignitionY + Math.sin(angle) * radius * 0.5;
        accent = random() > 0.28;
        alphaFade = 0.72 + random() * 0.28;
      }

      const sparkScale = index % 37 === 0 ? 1.85 : index % 13 === 0 ? 1.28 : 1;
      const size = (0.48 + Math.pow(random(), 2.2) * (isMobile ? 1.9 : 2.55)) * sparkScale;
      const alpha = (0.22 + random() * 0.7) * alphaFade;
      staticContext.fillStyle = accent
        ? `rgba(216,255,0,${Math.min(0.82, alpha * 1.16)})`
        : `rgba(240,237,228,${alpha})`;
      staticContext.fillRect(x - size * 0.5, y - size * 0.5, size, size);

      if (index % 7 === 0) {
        const length = 6 + random() * (isMobile ? 14 : 27);
        const angle = Math.atan2(centerY - y, centerX - x) + Math.PI * 0.5 + lane * 0.18;
        staticContext.beginPath();
        staticContext.moveTo(x, y);
        staticContext.lineTo(x + Math.cos(angle) * length, y + Math.sin(angle) * length);
        staticContext.strokeStyle = accent
          ? `rgba(216,255,0,${alpha * 0.82})`
          : `rgba(240,237,228,${alpha * 0.76})`;
        staticContext.lineWidth = 0.38 + random() * 0.52;
        staticContext.stroke();
      }
    }
  }

  function drawStaticField(seconds, scroll) {
    const reveal = smoothstep(0.9, 5.6, seconds);
    const fade = 1 - smoothstep(0.18, 0.9, scroll);
    if (reveal * fade < 0.002) return;
    ambientContext.save();
    ambientContext.globalAlpha = reveal * fade * 0.98;
    const driftX = reducedMotion.matches ? 0 : Math.sin(seconds * 0.075) * 2.2;
    const driftY = reducedMotion.matches ? 0 : Math.cos(seconds * 0.063) * 1.6;
    ambientContext.translate(driftX, driftY - scroll * height * 0.08);
    ambientContext.drawImage(staticFieldCanvas, 0, 0, width, height);
    ambientContext.restore();
  }

  function drawSwarm(seconds, scroll) {
    const reveal = smoothstep(0.75, 5.7, seconds);
    const depthFade = 1 - smoothstep(0.22, 0.94, scroll);
    const time = Math.max(0, seconds - 0.65);
    const centerX = width * (width < 700 ? 0.72 : 0.69);
    const centerY = height * (width < 700 ? 0.43 : 0.51);

    ambientContext.save();
    ambientContext.globalCompositeOperation = "lighter";
    ambientContext.lineCap = "round";

    for (let index = 0; index < swarm.length; index += 1) {
      const particle = swarm[index];
      const localReveal = smoothstep(particle.delay * 0.44, 2.6 + particle.delay, seconds);
      let progress = (particle.u + time * particle.speed) % 1;
      let x;
      let y;
      let routeFade = 1;

      if (particle.family === 0) {
        const p0x = -width * 0.16;
        const p0y = height * 0.64;
        const p1x = width * 0.31;
        const p1y = height * 0.94;
        const p2x = width * 0.53;
        const p2y = height * 0.08;
        const p3x = width * 1.14;
        const p3y = height * 0.57;
        x = cubic(p0x, p1x, p2x, p3x, progress);
        y = cubic(p0y, p1y, p2y, p3y, progress);
        const tangentX = cubicDerivative(p0x, p1x, p2x, p3x, progress);
        const tangentY = cubicDerivative(p0y, p1y, p2y, p3y, progress);
        const tangentLength = Math.hypot(tangentX, tangentY) || 1;
        const laneWidth = (width < 700 ? 34 : 88) * (0.3 + Math.sin(Math.PI * progress) * 0.7);
        x += (-tangentY / tangentLength) * particle.lane * laneWidth;
        y += (tangentX / tangentLength) * particle.lane * laneWidth;
        y += Math.sin(progress * 28 + particle.phase + time * 0.22) * (1.2 + particle.depth * 2.8);
        routeFade = Math.pow(Math.sin(Math.PI * progress), 0.42);
      } else if (particle.family === 1) {
        const angle = progress * Math.PI * 5.1 + particle.lane * 0.74 + Math.sin(time * 0.11 + particle.phase) * 0.08;
        const radius = mix(width * (0.42 + particle.lane * 0.035), width * 0.025, progress);
        x = centerX + Math.cos(angle) * radius;
        y = centerY + Math.sin(angle) * radius * (width < 700 ? 0.58 : 0.51);
        x += Math.sin(angle * 2.7 + time * 0.28) * 3.5 * particle.depth;
        routeFade = Math.pow(Math.sin(Math.PI * progress), 0.34);
      } else if (particle.family === 2) {
        const ignitionX = width * (width < 700 ? 0.77 : 0.79);
        const ignitionY = height * (width < 700 ? 0.5 : 0.72);
        const angle = particle.phase + progress * 1.2 + Math.sin(time * 0.08 + particle.phase) * 0.12;
        const radius = mix(width * 0.012, width * (0.13 + particle.depth * 0.075), progress);
        x = ignitionX + Math.cos(angle) * radius;
        y = ignitionY + Math.sin(angle) * radius * 0.54;
        routeFade = Math.pow(Math.sin(Math.PI * progress), 0.31);
      } else {
        x = width * particle.u + Math.cos(time * particle.speed * 8 + particle.phase) * (8 + particle.depth * 13);
        y = height * (0.06 + ((particle.phase / (Math.PI * 2)) * 0.88)) + Math.sin(time * particle.speed * 7 + particle.phase) * 10;
        routeFade = 0.52;
      }

      const pointerDx = x - pointer.x;
      const pointerDy = y - pointer.y;
      const pointerDistance = Math.hypot(pointerDx, pointerDy) || 1;
      const pointerField = reducedMotion.matches ? 0 : smoothstep(width < 700 ? 92 : 160, 8, pointerDistance);
      x += (pointerDx / pointerDistance) * pointerField * (2.5 + particle.depth * 5.5);
      y += (pointerDy / pointerDistance) * pointerField * (2.5 + particle.depth * 5.5);

      if (scroll > 0) {
        x += (x - centerX) * scroll * particle.depth * 0.56;
        y += (y - centerY) * scroll * particle.depth * 0.34 - scroll * height * particle.depth * 0.25;
      }

      if (!Number.isFinite(particle.x)) {
        particle.x = x;
        particle.y = y;
        particle.px = x;
        particle.py = y;
      } else {
        particle.px = particle.x;
        particle.py = particle.y;
        particle.x = x;
        particle.y = y;
      }

      const velocityX = particle.x - particle.px;
      const velocityY = particle.y - particle.py;
      const speed = Math.hypot(velocityX, velocityY);
      const alpha = particle.alpha * reveal * localReveal * depthFade * routeFade * (0.7 + particle.depth * 0.45);
      if (alpha < 0.003) continue;

      if ((particle.spark || index % 4 === 0) && speed < width * 0.08) {
        ambientContext.beginPath();
        ambientContext.moveTo(particle.x - velocityX * (particle.spark ? 3.8 : 2.15), particle.y - velocityY * (particle.spark ? 3.8 : 2.15));
        ambientContext.lineTo(particle.x, particle.y);
        ambientContext.strokeStyle = particle.accent
          ? `rgba(216,255,0,${Math.min(0.62, alpha * 0.58)})`
          : `rgba(240,237,228,${alpha * 0.42})`;
        ambientContext.lineWidth = Math.max(0.32, particle.size * (particle.spark ? 0.72 : 0.43));
        ambientContext.stroke();
      }

      ambientContext.fillStyle = particle.accent
        ? `rgba(216,255,0,${Math.min(0.82, alpha * 1.2)})`
        : `rgba(240,237,228,${alpha})`;
      const drawSize = particle.size * (particle.spark ? 1.42 : 1);
      ambientContext.fillRect(particle.x - drawSize * 0.5, particle.y - drawSize * 0.5, drawSize, drawSize);
    }

    ambientContext.restore();
  }

  function drawFilaments(seconds, scroll) {
    const reveal = smoothstep(2.65, 5.4, seconds);
    const release = 1 - smoothstep(9.2, 11.2, seconds);
    const restingCurrent = smoothstep(9.8, 11.4, seconds) * 0.34;
    const intensity = Math.max(reveal * release, restingCurrent) * (1 - smoothstep(0.12, 0.74, scroll));
    if (intensity < 0.002) return;

    const strands = width < 700 ? 4 : 6;
    const samples = width < 700 ? 34 : 44;
    const baseY = height * (width < 700 ? 0.405 : 0.57);

    ambientContext.save();
    ambientContext.globalCompositeOperation = "lighter";
    ambientContext.lineCap = "round";

    for (let strand = 0; strand < strands; strand += 1) {
      const spread = strand - (strands - 1) * 0.5;
      let previousX = 0;
      let previousY = 0;

      for (let sample = 0; sample <= samples; sample += 1) {
        const u = sample / samples;
        const inverse = 1 - u;
        const p0x = width * 0.13;
        const p0y = baseY + spread * 5;
        const p1x = width * 0.39;
        const p1y = height * 0.78 + spread * 9;
        const p2x = width * 0.58;
        const p2y = height * 0.25 - spread * 7;
        const p3x = width * 0.91;
        const p3y = height * 0.54 + spread * 4;
        const x = inverse * inverse * inverse * p0x + 3 * inverse * inverse * u * p1x + 3 * inverse * u * u * p2x + u * u * u * p3x;
        const y = inverse * inverse * inverse * p0y + 3 * inverse * inverse * u * p1y + 3 * inverse * u * u * p2y + u * u * u * p3y
          + Math.sin(u * 19 + seconds * 0.33 + strand * 0.71) * (0.6 + strand * 0.08);

        if (sample > 0) {
          const pulse = 0.2 + 0.8 * Math.pow(Math.max(0, Math.sin(u * 12.5 - seconds * 0.78 + strand)), 3);
          const centerFade = Math.sin(Math.PI * u);
          const alpha = intensity * centerFade * pulse * (strand === Math.floor(strands * 0.68) ? 0.14 : 0.082);
          if (alpha > 0.002) {
            ambientContext.beginPath();
            ambientContext.moveTo(previousX, previousY);
            ambientContext.lineTo(x, y);
            const acid = strand === Math.floor(strands * 0.68) && u > 0.55 && u < 0.76;
            ambientContext.strokeStyle = acid
              ? `rgba(216,255,0,${alpha * 1.42})`
              : `rgba(240,237,228,${alpha * 1.58})`;
            ambientContext.lineWidth = acid ? 0.76 : 0.38 + strand * 0.018;
            ambientContext.stroke();
          }
        }

        previousX = x;
        previousY = y;
      }
    }

    ambientContext.restore();
  }

  function drawParticles(seconds, scroll) {
    const motionAllowed = !reducedMotion.matches;
    const assemble = smoothstep(0.95, 5.35, seconds);
    const arrival = smoothstep(1.1, 3.9, seconds);
    const passageIn = smoothstep(5.0, 6.2, seconds);
    const passageOut = 1 - smoothstep(8.1, 9.25, seconds);
    const passage = passageIn * passageOut;
    const rest = smoothstep(8.4, 10.4, seconds);
    const loopCurrent = rest * (0.1 + (Math.sin((seconds - 10.4) * 0.52) + 1) * 0.045);
    const cursorRadius = width < 700 ? 105 : 168;
    const centerX = width * 0.58;
    const centerY = height * 0.5;

    context.save();
    context.lineCap = "round";
    context.globalCompositeOperation = "lighter";

    for (let index = 0; index < particles.length; index += 1) {
      const particle = particles[index];
      const localAssemble = smoothstep(0.9 + particle.delay * 0.48, 4.6 + particle.delay * 0.42, seconds);
      const ribbon = Math.sin((particle.tx / Math.max(1, width)) * 10 + seconds * 0.62 + particle.phase);
      const directedFlow = motionAllowed ? passage + loopCurrent : 0;
      const flowX = directedFlow * (64 + particle.depth * 88) * (particle.stream ? 1 : 0.38);
      const flowY = directedFlow * ribbon * (10 + particle.depth * 22);
      let targetX = mix(particle.ox, particle.tx, localAssemble) + flowX;
      let targetY = mix(particle.oy, particle.ty, localAssemble) + flowY;

      if (rest > 0 && motionAllowed) {
        const breath = particle.stream ? 8.5 : 2.2;
        targetX += Math.sin(seconds * 0.34 + particle.phase) * breath * rest;
        targetY += Math.cos(seconds * 0.28 + particle.phase) * (particle.stream ? 5.5 : 2.5) * rest;
      }

      const pointerDx = targetX - pointer.x;
      const pointerDy = targetY - pointer.y;
      const pointerDistance = Math.hypot(pointerDx, pointerDy) || 1;
      const field = smoothstep(cursorRadius, 12, pointerDistance);
      const pointerVelocity = Math.min(1, Math.hypot(pointer.x - pointer.px, pointer.y - pointer.py) / 16);
      const fieldStrength = motionAllowed
        ? field * (4.5 + pointerVelocity * 5.5) * particle.depth
        : 0;
      targetX += (pointerDx / pointerDistance) * fieldStrength;
      targetY += (pointerDy / pointerDistance) * fieldStrength;

      if (scroll > 0) {
        const depth = scroll * (0.42 + particle.depth * 0.85);
        targetX += (particle.tx - centerX) * depth * 0.42 + particle.drift * scroll * width * 0.2;
        targetY += (particle.ty - centerY) * depth * 0.34 - scroll * height * (0.28 + particle.depth * 0.42);
      }

      particle.px = particle.x;
      particle.py = particle.y;
      const ease = 0.022 + localAssemble * 0.018;
      particle.x += (targetX - particle.x) * ease;
      particle.y += (targetY - particle.y) * ease;

      const velocityX = particle.x - particle.px;
      const velocityY = particle.y - particle.py;
      const speed = Math.hypot(velocityX, velocityY);
      const alphaIn = smoothstep(particle.delay * 0.34, 1.5 + particle.delay * 0.5, seconds);
      const alphaOut = 1 - smoothstep(0.48, 1, scroll);
      const alpha = alphaIn * alphaOut * (0.23 + arrival * 0.55) * (0.72 + particle.depth * 0.28);
      const acid = particle.accent && (passage > 0.06 || field > 0.1);
      const radius = particle.size * (0.72 + particle.depth * 0.45) * (1 - scroll * 0.45);

      if (particle.stream && speed > 0.18 && assemble > 0.12) {
        context.beginPath();
        context.moveTo(particle.x - velocityX * (2.4 + passage * 4.5), particle.y - velocityY * (2.4 + passage * 4.5));
        context.lineTo(particle.x, particle.y);
        context.strokeStyle = acid
          ? `rgba(216,255,0,${alpha * 0.28})`
          : `rgba(240,237,228,${alpha * 0.2})`;
        context.lineWidth = Math.max(0.35, radius * 0.42);
        context.stroke();
      }

      context.beginPath();
      context.arc(particle.x, particle.y, Math.max(0.25, radius), 0, Math.PI * 2);
      context.fillStyle = acid
        ? `rgba(216,255,0,${Math.min(0.88, alpha * 1.35)})`
        : `rgba(240,237,228,${alpha})`;
      context.fill();
    }

    context.restore();
  }

  function drawSemanticThreads(seconds, progress, entry) {
    const intensity = entry * (0.34 + smoothstep(0.04, 0.54, progress) * 0.66);
    const threads = width < 700 ? 6 : 11;
    semanticContext.save();
    semanticContext.lineCap = "round";

    for (let index = 0; index < threads; index += 1) {
      const spread = index - (threads - 1) * 0.5;
      const drift = reducedMotion.matches ? 0 : Math.sin(seconds * 0.17 + index) * 4;
      semanticContext.beginPath();
      semanticContext.moveTo(-width * 0.08, height * (0.72 + spread * 0.028));
      semanticContext.bezierCurveTo(
        width * 0.27,
        height * (0.9 + spread * 0.018),
        width * 0.57,
        height * (0.14 - spread * 0.018),
        width * 1.08,
        height * (0.47 + spread * 0.024) + drift
      );
      const acid = index === Math.floor(threads * 0.7);
      semanticContext.strokeStyle = acid
        ? `rgba(126,147,0,${intensity * 0.28})`
        : `rgba(5,5,4,${intensity * (0.052 + index * 0.004)})`;
      semanticContext.lineWidth = acid ? 0.78 : 0.48;
      semanticContext.stroke();
    }

    semanticContext.restore();
  }

  function drawSemanticField(seconds) {
    const progress = reducedMotion.matches ? 1 : smoothSceneScroll;
    const entry = reducedMotion.matches ? 1 : smoothstep(0.12, 0.96, smoothSceneEntry);
    if (entry < 0.002) return;

    drawSemanticThreads(seconds, progress, entry);

    const assemble = reducedMotion.matches ? 1 : smoothstep(0.06, 0.58, progress);
    const meaning = reducedMotion.matches ? 0.35 : smoothstep(0.69, 0.96, progress);
    const stageRect = semanticStage.getBoundingClientRect();
    const localPointerX = pointer.x - stageRect.left;
    const localPointerY = pointer.y - stageRect.top;
    const lensEnabled = body.classList.contains("is-light-scene") && pointer.active && finePointer.matches && !reducedMotion.matches;
    const clusters = width < 700
      ? [[width * 0.24, height * 0.28], [width * 0.72, height * 0.42], [width * 0.57, height * 0.7]]
      : [[width * 0.2, height * 0.3], [width * 0.77, height * 0.28], [width * 0.73, height * 0.7]];

    semanticContext.save();
    semanticContext.lineCap = "round";
    semanticContext.textBaseline = "middle";

    for (let index = 0; index < semanticParticles.length; index += 1) {
      const particle = semanticParticles[index];
      const fallRange = height * 1.36;
      const fallingY = ((particle.oy + seconds * (7 + particle.speed * 10) + height * 0.18) % fallRange) - height * 0.18;
      const fallingX = particle.ox + Math.sin(seconds * 0.21 * particle.speed + particle.phase) * (5 + particle.depth * 10);
      let targetX = mix(fallingX, particle.tx, assemble);
      let targetY = mix(fallingY, particle.ty, assemble);

      if (!reducedMotion.matches) {
        targetX += Math.sin(seconds * 0.23 + particle.phase) * (1.5 + particle.depth * 2.8) * assemble;
        targetY += Math.cos(seconds * 0.19 + particle.phase) * (1.4 + particle.depth * 2.2) * assemble;
      }

      if (meaning > 0) {
        const cluster = clusters[index % clusters.length];
        const radius = 18 + particle.depth * (width < 700 ? 42 : 76);
        const clusterX = cluster[0] + Math.cos(particle.phase) * radius;
        const clusterY = cluster[1] + Math.sin(particle.phase) * radius * 0.58;
        targetX = mix(targetX, clusterX, meaning * 0.78);
        targetY = mix(targetY, clusterY, meaning * 0.78);
      }

      const pointerDx = targetX - localPointerX;
      const pointerDy = targetY - localPointerY;
      const pointerDistance = Math.hypot(pointerDx, pointerDy) || 1;
      const lensField = lensEnabled ? smoothstep(170, 12, pointerDistance) : 0;
      targetX = mix(targetX, particle.tx, lensField * 0.22);
      targetY = mix(targetY, particle.ty, lensField * 0.22);

      particle.px = particle.x;
      particle.py = particle.y;
      if (reducedMotion.matches) {
        particle.x = targetX;
        particle.y = targetY;
      } else {
        const ease = 0.032 + assemble * 0.024 + lensField * 0.018;
        particle.x += (targetX - particle.x) * ease;
        particle.y += (targetY - particle.y) * ease;
      }

      const velocityX = particle.x - particle.px;
      const velocityY = particle.y - particle.py;
      const alpha = entry * particle.alpha * (0.52 + assemble * 0.48) * (0.72 + lensField * 0.55);
      const size = particle.size * (0.72 + particle.depth * 0.42);
      const acid = particle.accent && (progress > 0.18 || lensField > 0.12);

      if (index % 4 === 0 && Math.hypot(velocityX, velocityY) < width * 0.08) {
        semanticContext.beginPath();
        semanticContext.moveTo(particle.x - velocityX * 2.8, particle.y - velocityY * 2.8);
        semanticContext.lineTo(particle.x, particle.y);
        semanticContext.strokeStyle = acid
          ? `rgba(126,147,0,${alpha * 0.58})`
          : `rgba(5,5,4,${alpha * 0.34})`;
        semanticContext.lineWidth = Math.max(0.35, size * 0.42);
        semanticContext.stroke();
      }

      if (particle.glyph && index % 3 === 0) {
        semanticContext.font = `${7 + particle.depth * 4}px "IBM Plex Mono", monospace`;
        semanticContext.fillStyle = acid
          ? `rgba(126,147,0,${Math.min(0.72, alpha)})`
          : `rgba(5,5,4,${alpha * 0.72})`;
        semanticContext.fillText(particle.glyph, particle.x, particle.y);
      } else {
        semanticContext.fillStyle = acid
          ? `rgba(126,147,0,${Math.min(0.84, alpha * 1.2)})`
          : `rgba(5,5,4,${alpha})`;
        semanticContext.fillRect(particle.x - size * 0.5, particle.y - size * 0.5, size, size);
      }
    }

    semanticContext.restore();
  }

  function drawOrbitPaths(seconds, progress, visibility, centerX, centerY) {
    const pathReveal = smoothstep(0.24, 0.61, progress);
    const settle = 1 - smoothstep(0.78, 0.96, progress) * 0.94;
    const intensity = visibility * pathReveal * settle;
    if (intensity < 0.002) return;

    orbitContext.save();
    orbitContext.lineCap = "round";

    for (let index = 0; index < orbitBands.length; index += 1) {
      const band = orbitBands[index];
      const mobileScale = width < 700 ? 1.48 : 1;
      const radiusX = width * band.rx * mobileScale;
      const radiusY = height * band.ry * (width < 700 ? 0.82 : 1);
      const drift = reducedMotion.matches ? 0 : Math.sin(seconds * 0.09 + index * 1.7) * 0.018;

      orbitContext.save();
      orbitContext.translate(centerX, centerY);
      orbitContext.rotate(band.rotation + drift);
      orbitContext.beginPath();
      orbitContext.ellipse(0, 0, radiusX, radiusY, 0, band.start, band.end);
      orbitContext.setLineDash(index % 2 ? [1.5, 7 + index * 1.8] : [18 + index * 5, 9 + index * 2]);
      orbitContext.lineDashOffset = reducedMotion.matches ? 0 : -seconds * (2.2 + index * 0.75) * band.direction;
      orbitContext.strokeStyle = index === 2
        ? `rgba(216,255,0,${intensity * 0.42})`
        : `rgba(240,237,228,${intensity * (0.065 + index * 0.018)})`;
      orbitContext.lineWidth = index === 2 ? 0.82 : 0.42 + index * 0.07;
      orbitContext.stroke();
      orbitContext.restore();
    }

    orbitContext.setLineDash([]);
    orbitContext.restore();
  }

  function drawOrbitField(seconds) {
    const progress = reducedMotion.matches ? targetOrbitScroll : smoothOrbitScroll;
    const visibility = reducedMotion.matches ? 1 : smoothstep(0.09, 0.32, progress);
    if (visibility < 0.002) return;

    const orbitRect = orbitStage.getBoundingClientRect();
    const stagePinned = orbitRect.top <= 1 && orbitRect.bottom >= height - 1;
    const pointerEnabled = stagePinned && pointer.active && finePointer.matches && !reducedMotion.matches;
    const localPointerX = pointer.x - orbitRect.left;
    const localPointerY = pointer.y - orbitRect.top;
    const centerPull = pointerEnabled ? 0.014 : 0;
    const centerX = width * 0.5 + (localPointerX - width * 0.5) * centerPull;
    const centerY = height * 0.5 + (localPointerY - height * 0.5) * centerPull;
    const sourceX = width * (width < 700 ? 0.95 : 0.92);
    const sourceY = height * (width < 700 ? 0.35 : 0.45);
    const capture = reducedMotion.matches ? 1 : smoothstep(0.18, 0.61, progress);
    const fieldReveal = reducedMotion.matches ? 1 : smoothstep(0.16, 0.39, progress);
    const collapse = smoothstep(0.78, 0.955, progress);
    const particleFade = 1 - smoothstep(0.94, 1, progress) * 0.76;

    drawOrbitPaths(seconds, progress, visibility, centerX, centerY);

    orbitContext.save();
    orbitContext.lineCap = "round";
    orbitContext.textBaseline = "middle";

    for (let index = 0; index < orbitParticles.length; index += 1) {
      const particle = orbitParticles[index];
      const band = orbitBands[particle.band];
      const mobileScale = width < 700 ? 1.48 : 1;
      const radiusX = width * band.rx * mobileScale * particle.radiusJitter;
      const radiusY = height * band.ry * (width < 700 ? 0.82 : 1) * particle.radiusJitter;
      const angle = particle.phase + particle.phaseOffset + seconds * particle.bandSpeed * particle.speedJitter;
      const cosine = Math.cos(angle);
      const sine = Math.sin(angle);
      const localX = cosine * radiusX;
      const localY = sine * radiusY;
      const rotationCosine = Math.cos(band.rotation);
      const rotationSine = Math.sin(band.rotation);
      const orbitX = centerX + localX * rotationCosine - localY * rotationSine;
      const orbitY = centerY + localX * rotationSine + localY * rotationCosine;
      const launchAngle = Math.atan2(particle.oy - sourceY, particle.ox - sourceX) + capture * (1.8 + particle.depth * 1.5) * band.direction;
      const launchDistance = Math.hypot(particle.ox - sourceX, particle.oy - sourceY) * (1 - capture * 0.58);
      const spiralX = sourceX + Math.cos(launchAngle) * launchDistance;
      const spiralY = sourceY + Math.sin(launchAngle) * launchDistance * 0.72;
      let targetX = mix(spiralX, orbitX, capture);
      let targetY = mix(spiralY, orbitY, capture);

      const pointerDx = localPointerX - targetX;
      const pointerDy = localPointerY - targetY;
      const pointerDistance = Math.hypot(pointerDx, pointerDy) || 1;
      const pointerField = pointerEnabled ? smoothstep(250, 22, pointerDistance) * (1 - collapse) : 0;
      targetX += pointerDx * pointerField * 0.075;
      targetY += pointerDy * pointerField * 0.075;

      if (collapse > 0) {
        const collapseRadius = mix(34 + particle.depth * 72, 3 + particle.depth * 8, collapse);
        const collapseAngle = particle.phase + collapse * 3.2 * band.direction;
        const collapsedX = orbitLogoTarget.x + Math.cos(collapseAngle) * collapseRadius;
        const collapsedY = orbitLogoTarget.y + Math.sin(collapseAngle) * collapseRadius * 0.64;
        targetX = mix(targetX, collapsedX, collapse);
        targetY = mix(targetY, collapsedY, collapse);
      }

      particle.px = particle.x;
      particle.py = particle.y;
      if (reducedMotion.matches) {
        particle.x = targetX;
        particle.y = targetY;
      } else {
        const ease = 0.035 + capture * 0.025 + pointerField * 0.02;
        particle.x += (targetX - particle.x) * ease;
        particle.y += (targetY - particle.y) * ease;
      }

      const velocityX = particle.x - particle.px;
      const velocityY = particle.y - particle.py;
      const speed = Math.hypot(velocityX, velocityY);
      const alpha = visibility * fieldReveal * particleFade * particle.alpha * (0.72 + pointerField * 0.5) * (1 - collapse * 0.34);
      const size = particle.size * (0.68 + particle.depth * 0.5);
      const acid = particle.accent && (progress > 0.3 || pointerField > 0.12);

      if (index % 3 === 0 && speed < width * 0.11) {
        const trail = 4.5 + particle.depth * 6.5;
        orbitContext.beginPath();
        orbitContext.moveTo(particle.x - velocityX * trail, particle.y - velocityY * trail);
        orbitContext.lineTo(particle.x, particle.y);
        orbitContext.strokeStyle = acid
          ? `rgba(216,255,0,${alpha * 0.6})`
          : `rgba(240,237,228,${alpha * 0.36})`;
        orbitContext.lineWidth = Math.max(0.32, size * 0.34);
        orbitContext.stroke();
      }

      if (particle.glyph && index % 2 === 0 && collapse < 0.46) {
        orbitContext.font = `${7 + particle.depth * 4.5}px "IBM Plex Mono", monospace`;
        orbitContext.fillStyle = acid
          ? `rgba(216,255,0,${Math.min(0.78, alpha)})`
          : `rgba(240,237,228,${alpha * 0.68})`;
        orbitContext.fillText(particle.glyph, particle.x, particle.y);
      } else {
        orbitContext.beginPath();
        orbitContext.arc(particle.x, particle.y, Math.max(0.3, size * 0.52), 0, Math.PI * 2);
        orbitContext.fillStyle = acid
          ? `rgba(216,255,0,${Math.min(0.86, alpha * 1.25)})`
          : `rgba(240,237,228,${alpha})`;
        orbitContext.fill();
      }
    }

    orbitContext.restore();
  }

  function workTargetX(particle, mode, seconds) {
    if (mode === 1) {
      const column = Math.floor(particle.seedX * 8);
      return width * (0.18 + column * 0.095) + Math.sin(seconds * 0.12 + particle.phase) * 2;
    }
    if (mode === 2) {
      return width * (0.1 + particle.seedX * 0.84) + Math.sin(seconds * 0.1 + particle.phase) * 4;
    }
    if (mode === 3) {
      const angle = particle.phase + seconds * (0.025 + particle.speed * 0.024);
      const radiusX = width * (0.11 + particle.seedX * 0.25);
      return width * 0.73 + Math.cos(angle) * radiusX;
    }
    return particle.originX + Math.sin(seconds * 0.18 + particle.phase) * (3 + particle.depth * 7);
  }

  function workTargetY(particle, mode, seconds) {
    if (mode === 1) {
      const row = Math.floor(particle.seedY * 14);
      return height * (0.15 + row * 0.052) + Math.cos(seconds * 0.11 + particle.phase) * 2;
    }
    if (mode === 2) {
      return height * (0.26 + particle.seedY * 0.48)
        + Math.sin(particle.seedX * 12 + seconds * 0.28 + particle.phase * 0.18) * height * 0.055;
    }
    if (mode === 3) {
      const angle = particle.phase + seconds * (0.025 + particle.speed * 0.024);
      const radiusY = height * (0.07 + particle.seedY * 0.23);
      return height * 0.51 + Math.sin(angle) * radiusY;
    }
    return particle.originY + Math.cos(seconds * 0.16 + particle.phase) * (3 + particle.depth * 6);
  }

  function drawWorkField(seconds) {
    const progress = reducedMotion.matches ? targetWorkScroll : smoothWorkScroll;
    const entry = reducedMotion.matches ? targetWorkEntry : smoothWorkEntry;
    const visibility = smoothstep(0.05, 0.55, entry) * (1 - smoothstep(0.9, 0.985, progress) * 0.55);
    if (visibility < 0.002) return;

    const rawMode = clamp((progress - 0.22) / 0.63 * 4, 0, 3.999);
    const mode = Math.floor(rawMode);
    const nextMode = Math.min(3, mode + 1);
    const modeBlend = smoothstep(0.58, 0.96, rawMode - mode);
    const stageRect = workStage.getBoundingClientRect();
    const stagePinned = stageRect.top <= 1 && stageRect.bottom >= height - 1;
    const localPointerX = pointer.x - stageRect.left;
    const localPointerY = pointer.y - stageRect.top;
    const pointerEnabled = stagePinned && pointer.active && finePointer.matches && !reducedMotion.matches;
    const contentReveal = smoothstep(0.14, 0.3, progress);

    workContext.save();
    workContext.lineCap = "round";
    workContext.textBaseline = "middle";
    workContext.globalCompositeOperation = "lighter";

    for (let index = 0; index < workParticles.length; index += 1) {
      const particle = workParticles[index];
      const fromX = workTargetX(particle, mode, seconds);
      const fromY = workTargetY(particle, mode, seconds);
      const toX = workTargetX(particle, nextMode, seconds);
      const toY = workTargetY(particle, nextMode, seconds);
      let targetX = mix(fromX, toX, modeBlend);
      let targetY = mix(fromY, toY, modeBlend);

      if (pointerEnabled) {
        const dx = localPointerX - targetX;
        const dy = localPointerY - targetY;
        const distance = Math.hypot(dx, dy) || 1;
        const field = smoothstep(210, 18, distance) * 0.045;
        targetX += dx * field;
        targetY += dy * field;
      }

      particle.px = particle.x;
      particle.py = particle.y;
      if (reducedMotion.matches) {
        particle.x = targetX;
        particle.y = targetY;
      } else {
        const ease = 0.025 + contentReveal * 0.025;
        particle.x += (targetX - particle.x) * ease;
        particle.y += (targetY - particle.y) * ease;
      }

      const alpha = visibility * particle.alpha * (0.42 + contentReveal * 0.58);
      const acid = particle.accent || (mode === 3 && index % 17 === 0);
      const size = particle.size * (0.7 + particle.depth * 0.44);

      if (index > 0 && index % 4 === 0) {
        const previous = workParticles[index - 1];
        const distance = Math.hypot(particle.x - previous.x, particle.y - previous.y);
        if (distance < width * (mode === 2 ? 0.12 : 0.075)) {
          workContext.beginPath();
          workContext.moveTo(previous.x, previous.y);
          workContext.lineTo(particle.x, particle.y);
          workContext.strokeStyle = acid
            ? `rgba(216,255,0,${alpha * 0.23})`
            : `rgba(240,237,228,${alpha * 0.12})`;
          workContext.lineWidth = 0.45;
          workContext.stroke();
        }
      }

      if (particle.glyph && mode !== 1) {
        workContext.font = `${6 + particle.depth * 3}px "IBM Plex Mono", monospace`;
        workContext.fillStyle = acid
          ? `rgba(216,255,0,${Math.min(0.68, alpha)})`
          : `rgba(240,237,228,${alpha * 0.5})`;
        workContext.fillText(particle.glyph, particle.x, particle.y);
      } else {
        workContext.beginPath();
        workContext.arc(particle.x, particle.y, Math.max(0.28, size * 0.5), 0, Math.PI * 2);
        workContext.fillStyle = acid
          ? `rgba(216,255,0,${Math.min(0.78, alpha * 1.15)})`
          : `rgba(240,237,228,${alpha})`;
        workContext.fill();
      }
    }

    workContext.restore();
  }

  function render(now) {
    if (!pageVisible) return;
    if (!startTime) startTime = now;
    if (now - lastFrame < 12) {
      rafId = requestAnimationFrame(render);
      return;
    }
    lastFrame = now;
    const seconds = (now - startTime) / 1000;

    if (!reducedMotion.matches) updatePointer(now);
    updateDocumentMotion();

    if (heroVisible) {
      ambientContext.clearRect(0, 0, width, height);
      context.clearRect(0, 0, width, height);

      if (reducedMotion.matches) {
        drawStaticField(12, smoothScroll);
        drawFragments(12, smoothScroll);
        drawSwarm(12, smoothScroll);
        drawFilaments(12, smoothScroll);
        drawParticles(12, smoothScroll);
      } else {
        drawStaticField(seconds, smoothScroll);
        drawFragments(seconds, smoothScroll);
        drawSwarm(seconds, smoothScroll);
        drawFilaments(seconds, smoothScroll);
        drawParticles(seconds, smoothScroll);
      }
    }

    if (sceneVisible) {
      semanticContext.clearRect(0, 0, width, height);
      drawSemanticField(reducedMotion.matches ? 12 : seconds);
    }

    if (orbitVisible) {
      orbitContext.clearRect(0, 0, width, height);
      drawOrbitField(reducedMotion.matches ? 12 : seconds);
    }

    if (workVisible) {
      workContext.clearRect(0, 0, width, height);
      drawWorkField(reducedMotion.matches ? 12 : seconds);
    }

    rafId = requestAnimationFrame(render);
  }

  function onPointerMove(event) {
    pointer.tx = event.clientX;
    pointer.ty = event.clientY;
    pointer.active = true;
    pointer.lastMove = performance.now();
    if (finePointer.matches) body.classList.add("has-pointer");
  }

  function onPointerLeave() {
    pointer.active = false;
    body.classList.remove("has-pointer");
  }

  function onVisibilityChange() {
    pageVisible = !document.hidden;
    if (pageVisible && !rafId) rafId = requestAnimationFrame(render);
    if (!pageVisible && rafId) {
      cancelAnimationFrame(rafId);
      rafId = 0;
    }
  }

  function start() {
    applyConfig();
    const fontsReady = document.fonts ? document.fonts.ready : Promise.resolve();
    fontsReady.finally(() => {
      resize();
      requestAnimationFrame(() => {
        const initialTarget = window.location.hash
          ? document.querySelector(window.location.hash)
          : null;
        if (initialTarget) {
          initialTarget.scrollIntoView({ block: "start" });
          updateScrollTarget();
          smoothScroll = targetScroll;
          smoothSceneScroll = targetSceneScroll;
          smoothSceneEntry = targetSceneEntry;
          smoothOrbitScroll = targetOrbitScroll;
          smoothOrbitEntry = targetOrbitEntry;
          smoothWorkScroll = targetWorkScroll;
          smoothWorkEntry = targetWorkEntry;
          updateDocumentMotion();
        }
        body.classList.add("is-ready");
      });
      rafId = requestAnimationFrame(render);
    });
  }

  window.addEventListener("resize", resize, { passive: true });
  window.addEventListener("scroll", updateScrollTarget, { passive: true });
  window.addEventListener("pointermove", onPointerMove, { passive: true });
  document.documentElement.addEventListener("pointerleave", onPointerLeave);
  document.addEventListener("visibilitychange", onVisibilityChange);
  document.addEventListener("keydown", onNavigationKeydown);
  document.addEventListener("pointerdown", onNavigationPointerDown);
  orbitNavToggle.addEventListener("click", () => setNavigationOpen(!navigationOpen, false));
  orbitNavLinks.forEach((link) => link.addEventListener("click", () => setNavigationOpen(false, false)));
  reducedMotion.addEventListener("change", resize);
  finePointer.addEventListener("change", () => body.classList.remove("has-pointer"));

  start();
})();
