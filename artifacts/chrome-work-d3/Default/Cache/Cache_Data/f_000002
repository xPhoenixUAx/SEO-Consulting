  ];
  const orbitBands = [
    { rx: 0.19, ry: 0.075, rotation: -0.18, speed: 0.19, direction: 1, start: 0.22, end: 5.36 },
    { rx: 0.27, ry: 0.115, rotation: 0.14, speed: 0.12, direction: -1, start: 1.04, end: 6.02 },
    { rx: 0.36, ry: 0.165, rotation: -0.09, speed: 0.082, direction: 1, start: 2.18, end: 6.13 },
