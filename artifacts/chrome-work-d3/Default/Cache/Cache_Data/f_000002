    { rx: 0.59, ry: 0.32, rotation: -0.13, speed: 0.036, direction: 1, start: 0.72, end: 5.71 }
  ];

  let width = 0;
  let height = 0;
  let dpr = 1;
  let particles = [];
  let fragments = [];
  let swarm = [];
  let semanticParticles = [];
  let orbitParticles = [];
  let workParticles = [];
  let rafId = 0;
  let startTime = 0;
  let lastFrame = 0;
  let targetScroll = 0;
  let smoothScroll = 0;
  let targetSceneScroll = 0;
  let smoothSceneScroll = 0;
  let targetSceneEntry = 0;
  let smoothSceneEntry = 0;
  let targetOrbitScroll = 0;
  let smoothOrbitScroll = 0;
  let targetOrbitEntry = 0;
  let smoothOrbitEntry = 0;
  let targetWorkScroll = 0;
  let smoothWorkScroll = 0;
  let targetWorkEntry = 0;
  let smoothWorkEntry = 0;
  let heroVisible = true;
  let sceneVisible = false;
  let orbitVisible = false;
  let workVisible = false;
  let pageVisible = true;
  let navigationOpen = false;
  let logoDocked = false;
  const orbitLogoTarget = { x: window.innerWidth * 0.5, y: window.innerHeight * 0.5 };

  const pointer = {
    x: window.innerWidth * 0.72,
    y: window.innerHeight * 0.58,
    tx: window.innerWidth * 0.72,
    ty: window.innerHeight * 0.58,
    px: window.innerWidth * 0.72,
