    active: false,
    lastMove: 0
  };

  function applyConfig() {
    document.querySelectorAll("[data-config]").forEach((element) => {
      const value = config[element.dataset.config];
      if (typeof value !== "string") return;

      if (element.dataset.config === "heroCopy") {
        element.innerHTML = value.split("\n").map(escapeHtml).join("<br>");
      } else if (element.dataset.config === "sceneThreeTitle") {
        const title = value.trim().toUpperCase() || "ORBIT";
        const letter = element.querySelector(".orbit-title__letter");
        const tail = element.querySelector(".orbit-title__tail");
        if (letter && tail) {
          letter.textContent = title.slice(0, 1);
          letter.dataset.text = title.slice(0, 1);
          tail.textContent = title.slice(1);
          tail.dataset.text = title.slice(1);
          const heading = element.closest(".orbit-title");
          if (heading) heading.setAttribute("aria-label", `Be ${title}`);
        }
      } else {
        element.textContent = value;
        if (element.hasAttribute("data-text")) element.dataset.text = value;
      }
    });

    document.querySelectorAll("[data-config-href]").forEach((element) => {
      const value = config[element.dataset.configHref];
      if (typeof value === "string" && value.trim()) element.setAttribute("href", value.trim());
    });

    workChapters.forEach((chapter) => {
      const title = chapter.querySelector("h3");
      if (title) title.dataset.echo = title.textContent.trim();
    });
  }

  function escapeHtml(value) {
    const node = document.createElement("span");
    node.textContent = value;
    return node.innerHTML;
  }

  function clamp(value, min, max) {
    return Math.min(max, Math.max(min, value));
  }

  function mix(from, to, amount) {
    return from + (to - from) * amount;
  }

  function smoothstep(edge0, edge1, value) {
    const amount = clamp((value - edge0) / (edge1 - edge0), 0, 1);
    return amount * amount * (3 - 2 * amount);
  }

  function mulberry32(seed) {
    return function random() {
      let value = seed += 0x6D2B79F5;
      value = Math.imul(value ^ value >>> 15, value | 1);
      value ^= value + Math.imul(value ^ value >>> 7, value | 61);
      return ((value ^ value >>> 14) >>> 0) / 4294967296;
    };
  }

  function sampleTextEdges() {
    const mask = document.createElement("canvas");
    const maskContext = mask.getContext("2d", { willReadFrequently: true });
    const scale = width > 900 ? 0.54 : 0.66;
    mask.width = Math.max(1, Math.floor(width * scale));
    mask.height = Math.max(1, Math.floor(height * scale));
    maskContext.scale(scale, scale);
    maskContext.fillStyle = "#fff";
    maskContext.textBaseline = "top";
    maskContext.textAlign = "left";

    document.querySelectorAll(".headline__line").forEach((line) => {
      const rect = line.getBoundingClientRect();
      const style = getComputedStyle(line);
      maskContext.font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
      if ("letterSpacing" in maskContext) maskContext.letterSpacing = style.letterSpacing;
      maskContext.fillText(line.firstChild.textContent.trim(), rect.left, rect.top - parseFloat(style.fontSize) * 0.055);
    });

    const pixels = maskContext.getImageData(0, 0, mask.width, mask.height).data;
    const points = [];
    const stride = width > 900 ? 4 : 3;
    const radius = Math.max(2, Math.round(3 * scale));

    for (let y = radius; y < mask.height - radius; y += stride) {
      for (let x = radius; x < mask.width - radius; x += stride) {
        const alpha = pixels[(y * mask.width + x) * 4 + 3];
        if (alpha < 90) continue;
        const left = pixels[(y * mask.width + x - radius) * 4 + 3];
        const right = pixels[(y * mask.width + x + radius) * 4 + 3];
        const above = pixels[((y - radius) * mask.width + x) * 4 + 3];
        const below = pixels[((y + radius) * mask.width + x) * 4 + 3];
        if (left < 45 || right < 45 || above < 45 || below < 45) {
          points.push({ x: x / scale, y: y / scale });
        }
      }
    }

    return points;
  }

  function buildField() {
    const random = mulberry32(7142026);
    const edgePoints = sampleTextEdges();
    const isMobile = width < 700;
    const memory = navigator.deviceMemory || 8;
    const targetCount = reducedMotion.matches
      ? Math.min(130, edgePoints.length)
      : Math.min(edgePoints.length, isMobile ? 300 : memory <= 4 ? 520 : 680);

    particles = new Array(targetCount);
    for (let index = 0; index < targetCount; index += 1) {
      const point = edgePoints[Math.floor((index / targetCount) * edgePoints.length)] || { x: width / 2, y: height / 2 };
      const fromLeft = random() < 0.53;
      const lane = random();
      const startX = reducedMotion.matches
        ? point.x
        : fromLeft ? -width * (0.05 + random() * 0.3) : width * (1.04 + random() * 0.28);
      const startY = reducedMotion.matches
        ? point.y
        : height * (0.18 + lane * 0.67) + Math.sin(lane * Math.PI * 4) * height * 0.08;
      const accent = random() > 0.925;

      particles[index] = {
        x: startX,
        y: startY,
        ox: startX,
        oy: startY,
        px: startX,
        py: startY,
        tx: point.x,
        ty: point.y,
        phase: random() * Math.PI * 2,
        depth: 0.35 + random() * 0.65,
        size: 0.35 + random() * 1.25,
        delay: random() * 2.25,
        accent,
        stream: random() > 0.7,
        drift: random() * 2 - 1
      };
    }

    const swarmCount = reducedMotion.matches
      ? isMobile ? 280 : 520
      : isMobile ? 310 : memory <= 4 ? 420 : 520;
    swarm = new Array(swarmCount);
    for (let index = 0; index < swarmCount; index += 1) {
      const familyRoll = random();
      const family = familyRoll < 0.52 ? 0 : familyRoll < 0.78 ? 1 : familyRoll < 0.93 ? 2 : 3;
      swarm[index] = {
        family,
        u: random(),
        lane: random() * 2 - 1,
        phase: random() * Math.PI * 2,
        speed: 0.012 + random() * 0.034,
        depth: 0.25 + random() * 0.75,
        size: 0.34 + Math.pow(random(), 2.15) * 2.05,
        alpha: 0.28 + random() * 0.55,
        accent: family === 2 ? random() > 0.24 : random() > 0.925,
        spark: random() > 0.965,
        delay: random() * 3.2,
        x: NaN,
        y: NaN,
        px: NaN,
        py: NaN
      };
    }

    const fragmentCount = reducedMotion.matches ? 24 : isMobile ? 42 : 72;
    fragments = new Array(fragmentCount);
    for (let index = 0; index < fragmentCount; index += 1) {
      const label = random() > 0.6 ? words[Math.floor(random() * words.length)] : String.fromCharCode(97 + Math.floor(random() * 26));
      fragments[index] = {
        x: width * (0.05 + random() * 0.92),
        y: height * (0.08 + random() * 0.84),
        baseY: height * (0.08 + random() * 0.84),
        phase: random() * Math.PI * 2,
        speed: 0.25 + random() * 0.7,
        alpha: 0.18 + random() * 0.48,
        size: (isMobile ? 6 : 7) + random() * (isMobile ? 6 : 9),
        label,
        accent: random() > 0.84,
        delay: 0.9 + random() * 4.3,
        depth: 0.25 + random() * 0.75,
        orbit: random() > 0.28 ? random() * 2 - 1 : 0
      };
    }
  }

  function sampleSemanticEdges() {
    if (!semanticStage) return [];
    const mask = document.createElement("canvas");
    const maskContext = mask.getContext("2d", { willReadFrequently: true });
    const scale = width > 900 ? 0.5 : 0.64;
    const stageRect = semanticStage.getBoundingClientRect();
    mask.width = Math.max(1, Math.floor(width * scale));
    mask.height = Math.max(1, Math.floor(height * scale));
    maskContext.scale(scale, scale);
    maskContext.fillStyle = "#000";
    maskContext.textBaseline = "top";
    maskContext.textAlign = "left";

    document.querySelectorAll(".semantic-title__word").forEach((word) => {
      const rect = word.getBoundingClientRect();
      const style = getComputedStyle(word);
      maskContext.font = `${style.fontWeight} ${style.fontSize} ${style.fontFamily}`;
      if ("letterSpacing" in maskContext) maskContext.letterSpacing = style.letterSpacing;
      if ("fontStretch" in maskContext) maskContext.fontStretch = style.fontStretch;
      maskContext.fillText(
        word.textContent.trim(),
        rect.left - stageRect.left,
        rect.top - stageRect.top - parseFloat(style.fontSize) * 0.05
      );
    });

    const pixels = maskContext.getImageData(0, 0, mask.width, mask.height).data;
    const points = [];
    const stride = width > 900 ? 4 : 3;
    const radius = Math.max(2, Math.round(3 * scale));

    for (let y = radius; y < mask.height - radius; y += stride) {
      for (let x = radius; x < mask.width - radius; x += stride) {
        const alpha = pixels[(y * mask.width + x) * 4 + 3];
        if (alpha < 80) continue;
        const left = pixels[(y * mask.width + x - radius) * 4 + 3];
        const right = pixels[(y * mask.width + x + radius) * 4 + 3];
        const above = pixels[((y - radius) * mask.width + x) * 4 + 3];
        const below = pixels[((y + radius) * mask.width + x) * 4 + 3];
        if (left < 40 || right < 40 || above < 40 || below < 40) {
          points.push({ x: x / scale, y: y / scale });
        }
      }
    }

    return points;
  }

  function buildSemanticField() {
    if (!semanticStage) return;
    const random = mulberry32(28082026);
    const edgePoints = sampleSemanticEdges();
    const isMobile = width < 700;
    const memory = navigator.deviceMemory || 8;
    const count = reducedMotion.matches
      ? isMobile ? 150 : 230
      : isMobile ? 520 : memory <= 4 ? 720 : 1080;

    semanticParticles = new Array(count);
    for (let index = 0; index < count; index += 1) {
      const point = edgePoints.length
        ? edgePoints[(index * 17 + Math.floor(random() * 11)) % edgePoints.length]
        : { x: width * 0.5, y: height * 0.48 };
      const originX = random() * width;
      const originY = -height * 0.18 + random() * height * 1.28;
      const stationary = reducedMotion.matches;
      semanticParticles[index] = {
        x: stationary ? point.x : originX,
        y: stationary ? point.y : originY,
        px: stationary ? point.x : originX,
        py: stationary ? point.y : originY,
        ox: originX,
        oy: originY,
        tx: point.x,
        ty: point.y,
        depth: 0.25 + random() * 0.75,
        size: 0.42 + Math.pow(random(), 2) * 1.85,
        alpha: 0.2 + random() * 0.5,
        phase: random() * Math.PI * 2,
        speed: 0.25 + random() * 0.8,
        accent: random() > 0.925,
        glyph: random() > 0.955 ? words[Math.floor(random() * words.length)] : ""
      };
    }
  }

  function buildOrbitField() {
    if (!orbitStage) return;
    const random = mulberry32(31082026);
    const isMobile = width < 700;
    const memory = navigator.deviceMemory || 8;
    const count = reducedMotion.matches
      ? isMobile ? 210 : 320
      : isMobile ? 640 : memory <= 4 ? 860 : 1320;
    const sourceX = width * (isMobile ? 0.95 : 0.92);
    const sourceY = height * (isMobile ? 0.35 : 0.45);

    orbitParticles = new Array(count);
    for (let index = 0; index < count; index += 1) {
      const bandIndex = index % orbitBands.length;
      const band = orbitBands[bandIndex];
      const phase = random() * Math.PI * 2;
      const launchRadius = 10 + Math.pow(random(), 1.8) * Math.min(width, height) * 0.36;
      const launchAngle = phase + (random() - 0.5) * 0.9;
      const originX = sourceX + Math.cos(launchAngle) * launchRadius;
      const originY = sourceY + Math.sin(launchAngle) * launchRadius * 0.64;

      orbitParticles[index] = {
        x: originX,
        y: originY,
        px: originX,
        py: originY,
        ox: originX,
        oy: originY,
        phase,
        band: bandIndex,
        radiusJitter: 0.86 + random() * 0.28,
        speedJitter: 0.72 + random() * 0.56,
        depth: 0.18 + random() * 0.82,
        size: 0.36 + Math.pow(random(), 2.1) * 1.95,
        alpha: 0.16 + random() * 0.58,
        accent: random() > 0.91,
        glyph: random() > 0.958 ? words[Math.floor(random() * words.length)] : "",
        phaseOffset: (random() - 0.5) * 0.22,
        bandSpeed: band.speed * band.direction
      };
    }
  }

  function buildWorkField() {
    if (!workStage) return;
    const random = mulberry32(4082026);
    const isMobile = width < 700;
    const memory = navigator.deviceMemory || 8;
    const count = reducedMotion.matches
      ? isMobile ? 90 : 140
      : isMobile ? 260 : memory <= 4 ? 360 : 520;

    workParticles = new Array(count);
    for (let index = 0; index < count; index += 1) {
      const originX = width * (0.07 + random() * 0.9);
      const originY = height * (0.1 + random() * 0.82);
      workParticles[index] = {
        x: originX,
        y: originY,
        px: originX,
        py: originY,
        originX,
        originY,
        seedX: random(),
        seedY: random(),
        phase: random() * Math.PI * 2,
        depth: 0.22 + random() * 0.78,
        size: 0.38 + Math.pow(random(), 2.2) * 1.7,
        alpha: 0.13 + random() * 0.48,
        speed: 0.35 + random() * 0.85,
        accent: random() > 0.915,
        glyph: random() > 0.965 ? words[Math.floor(random() * words.length)] : ""
      };
    }
  }

  function resize() {
    width = window.innerWidth;
    height = window.innerHeight;
    dpr = Math.min(window.devicePixelRatio || 1, width < 700 ? 1.25 : 1.45);
    canvas.width = Math.round(width * dpr);
    canvas.height = Math.round(height * dpr);
    ambientCanvas.width = Math.round(width * dpr);
    ambientCanvas.height = Math.round(height * dpr);
    semanticCanvas.width = Math.round(width * dpr);
    semanticCanvas.height = Math.round(height * dpr);
    orbitCanvas.width = Math.round(width * dpr);
    orbitCanvas.height = Math.round(height * dpr);
    workCanvas.width = Math.round(width * dpr);
    workCanvas.height = Math.round(height * dpr);
    canvas.style.width = `${width}px`;
    canvas.style.height = `${height}px`;
    ambientCanvas.style.width = `${width}px`;
    ambientCanvas.style.height = `${height}px`;
    semanticCanvas.style.width = `${width}px`;
    semanticCanvas.style.height = `${height}px`;
    orbitCanvas.style.width = `${width}px`;
    orbitCanvas.style.height = `${height}px`;
    workCanvas.style.width = `${width}px`;
    workCanvas.style.height = `${height}px`;
    context.setTransform(dpr, 0, 0, dpr, 0, 0);
    ambientContext.setTransform(dpr, 0, 0, dpr, 0, 0);
    semanticContext.setTransform(dpr, 0, 0, dpr, 0, 0);
    orbitContext.setTransform(dpr, 0, 0, dpr, 0, 0);
    workContext.setTransform(dpr, 0, 0, dpr, 0, 0);
    buildField();
    buildStaticField();
    buildSemanticField();
    buildOrbitField();
    buildWorkField();
    updateScrollTarget();
  }

  function updateScrollTarget() {
    if (!heroTrack) return;
    const rect = heroTrack.getBoundingClientRect();
    const travel = Math.max(1, rect.height - height);
    targetScroll = clamp(-rect.top / travel, 0, 1);
    heroVisible = rect.bottom > 0 && rect.top < height;

    if (sceneTwo) {
      const sceneRect = sceneTwo.getBoundingClientRect();
      const sceneTravel = Math.max(1, sceneRect.height - height);
      targetSceneScroll = clamp(-sceneRect.top / sceneTravel, 0, 1);
      targetSceneEntry = clamp(1 - sceneRect.top / height, 0, 1);
      sceneVisible = sceneRect.top < height && sceneRect.bottom > 0;
    }

    if (sceneThree) {
      const orbitRect = sceneThree.getBoundingClientRect();
      const orbitTravel = Math.max(1, orbitRect.height - height);
      targetOrbitScroll = clamp(-orbitRect.top / orbitTravel, 0, 1);
      targetOrbitEntry = clamp(1 - orbitRect.top / height, 0, 1);
      orbitVisible = orbitRect.top < height && orbitRect.bottom > 0;
    }

    if (sceneFour) {
      const workRect = sceneFour.getBoundingClientRect();
      const workTravel = Math.max(1, workRect.height - height);
      targetWorkScroll = clamp(-workRect.top / workTravel, 0, 1);
      targetWorkEntry = clamp(1 - workRect.top / height, 0, 1);
      workVisible = workRect.top < height && workRect.bottom > 0;
    }
  }

  function updateDocumentMotion() {
    smoothScroll = reducedMotion.matches
      ? targetScroll
      : smoothScroll + (targetScroll - smoothScroll) * 0.085;
    smoothSceneScroll = reducedMotion.matches
      ? targetSceneScroll
      : smoothSceneScroll + (targetSceneScroll - smoothSceneScroll) * 0.075;
    smoothSceneEntry = reducedMotion.matches
      ? targetSceneEntry
      : smoothSceneEntry + (targetSceneEntry - smoothSceneEntry) * 0.09;
    smoothOrbitScroll = reducedMotion.matches
      ? targetOrbitScroll
      : smoothOrbitScroll + (targetOrbitScroll - smoothOrbitScroll) * 0.072;
    smoothOrbitEntry = reducedMotion.matches
      ? targetOrbitEntry
      : smoothOrbitEntry + (targetOrbitEntry - smoothOrbitEntry) * 0.085;
    smoothWorkScroll = reducedMotion.matches
      ? targetWorkScroll
      : smoothWorkScroll + (targetWorkScroll - smoothWorkScroll) * 0.07;
    smoothWorkEntry = reducedMotion.matches
      ? targetWorkEntry
      : smoothWorkEntry + (targetWorkEntry - smoothWorkEntry) * 0.085;
    root.style.setProperty("--scroll", smoothScroll.toFixed(4));
    root.style.setProperty("--headline-y", `${(-smoothScroll * 24).toFixed(3)}vh`);
    root.style.setProperty("--headline-scale", (1 - smoothScroll * 0.045).toFixed(4));
    root.style.setProperty("--headline-opacity", clamp(1 - smoothScroll * 0.94, 0, 1).toFixed(4));
    root.style.setProperty("--atmosphere-opacity", clamp(1 - smoothScroll, 0, 1).toFixed(4));
    root.style.setProperty("--header-y", `${(-smoothScroll * 18).toFixed(2)}px`);
    root.style.setProperty("--header-opacity", clamp(1 - smoothScroll * 1.18, 0, 1).toFixed(4));

    const sceneProgress = reducedMotion.matches ? 1 : smoothSceneScroll;
    const titleReveal = smoothstep(0.22, 0.92, smoothSceneEntry);
    const scanOne = reducedMotion.matches ? 1 : smoothstep(0.06, 0.43, sceneProgress);
    const scanTwo = reducedMotion.matches ? 1 : smoothstep(0.27, 0.67, sceneProgress);
    const scanTravel = smoothstep(0.04, 0.72, sceneProgress);
    const scanOpacity = reducedMotion.matches
      ? 0
      : smoothstep(0.03, 0.12, sceneProgress) * (1 - smoothstep(0.73, 0.86, sceneProgress));
    const copyOpacity = reducedMotion.matches ? 1 : smoothstep(0.5, 0.75, sceneProgress);
    const metaOpacity = 0.18 + smoothstep(0.18, 0.84, smoothSceneEntry) * 0.68;

    root.style.setProperty("--scene-progress", sceneProgress.toFixed(4));
    root.style.setProperty("--scene-title-y", `${((1 - titleReveal) * 42).toFixed(2)}px`);
    root.style.setProperty("--scene-copy-opacity", copyOpacity.toFixed(4));
    root.style.setProperty("--scene-copy-y", `${((1 - copyOpacity) * 16).toFixed(2)}px`);
    root.style.setProperty("--scene-meta-opacity", metaOpacity.toFixed(4));
    root.style.setProperty("--scan-one-clip", `${((1 - scanOne) * 101).toFixed(3)}%`);
    root.style.setProperty("--scan-two-clip", `${((1 - scanTwo) * 101).toFixed(3)}%`);
    root.style.setProperty("--scan-x", `${(-6 + scanTravel * 112).toFixed(3)}%`);
    root.style.setProperty("--scan-opacity", scanOpacity.toFixed(4));

    const stageRect = semanticStage ? semanticStage.getBoundingClientRect() : null;
    const stagePinned = stageRect && stageRect.top <= 1 && stageRect.bottom >= height - 1;
    const orbitStillLight = orbitVisible && smoothOrbitScroll < 0.12;
    const lightSceneActive = (sceneVisible && smoothSceneEntry > 0.42 && !orbitVisible) || orbitStillLight;
    const lensActive = lightSceneActive && stagePinned && pointer.active && finePointer.matches && !reducedMotion.matches;
