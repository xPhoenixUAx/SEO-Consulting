@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  *,
  *::before,
  *::after {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: 0.001ms !important;
  }

  .headline__line,
  .hero__copy,
  .hero__index,
  .hero__statement,
  .scroll-cue {
    animation: none !important;
    opacity: 1;
    filter: none;
    clip-path: none;
    transform: none;
  }

  .headline__line::before,
  .headline__line::after,
  .grain,
  .semantic-paper::after,
  .orbit-grain {
    animation: none !important;
  }

  .semantic-title {
    transform: none;
  }

  .semantic-title__word::after {
    clip-path: none !important;
  }

  .semantic-scan,
  .semantic-lens {
    display: none !important;
  }

  .scene-two__manifesto,
  .scene-two__topline,
  .scene-two__kicker,
  .scene-two__footer {
    opacity: 1;
    transform: none;
  }

  .semantic-terms span {
    opacity: 0.65 !important;
    transform: none !important;
  }

  .scene-three__stage {
    background: var(--black);
  }

  .orbit-eclipse {
    display: none;
  }

  .orbit-space,
  .orbit-title {
    opacity: 1;
  }

  .orbit-title {
    transform: translate(-47%, -50%);
  }

  .orbit-title__be::after,
  .orbit-title__letter::after,
  .orbit-title__tail::after {
    clip-path: none !important;
  }

  .scene-three__copy {
    transform: none;
  }

  .orbit-nav__panel,
  .orbit-nav__trace,
  .orbit-nav__brand,
  .orbit-nav__links a,
  .orbit-nav__status {
    transition-duration: 0.001ms !important;
    transition-delay: 0ms !important;
  }

  .work-grain {
    animation: none !important;
  }

  .work-intro,
  .work-system,
  .work-verdict,
  .work-chapter {
    transition: none !important;
  }

  .cursor {
    display: none !important;
  }
}
